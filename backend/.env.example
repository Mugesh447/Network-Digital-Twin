# SMTP settings for POST /api/alerts/email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM=alerts@example.com
ALERT_EMAIL_TO=network-team@example.com

# Optional GNS3 API push settings
GNS3_SERVER_URL=http://127.0.0.1:3080
GNS3_PROJECT_ID=replace-with-existing-project-id
GNS3_AUTH_TOKEN=
